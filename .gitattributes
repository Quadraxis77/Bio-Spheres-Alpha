# Keep source line endings consistent across Windows, Linux, and macOS.
* text=auto
/.gitattributes text eol=lf
/.gitignore text eol=lf
*.rs text eol=lf
*.wgsl text eol=lf
*.toml text eol=lf
*.ron text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.ogg binary
*.wav binary
